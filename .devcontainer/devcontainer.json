{
  "name": "AgentBin Dev",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",

  // Podman compatibility: explicit user settings ensure rootless Podman maps UIDs correctly.
  // The devcontainer CLI auto-detects Podman and adds --userns=keep-id when needed.
  "remoteUser": "vscode",
  "containerUser": "vscode",
  "updateRemoteUserUID": true,

  "features": {
    "ghcr.io/devcontainers/features/dotnet:2": {
      "version": "10.0"
    },
    "ghcr.io/devcontainers/features/go:1": {
      "version": "1.24"
    },
    "ghcr.io/devcontainers/features/python:1": {
      "version": "3.12"
    },
    "ghcr.io/devcontainers/features/rust:1": {
      "version": "latest"
    },
    "ghcr.io/devcontainers/features/java:1": {
      "version": "21",
      "installMaven": "true"
    },
    "ghcr.io/devcontainers/features/node:1": {
      "version": "20"
    },
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-dotnettools.csdevkit",
        "golang.go",
        "ms-python.python",
        "rust-lang.rust-analyzer",
        "redhat.java",
        "dbaeumer.vscode-eslint"
      ]
    }
  },
  "forwardPorts": [5000, 5100, 5200, 5300, 5400],
  "postCreateCommand": "bash .devcontainer/post-create.sh",

  // Podman on SELinux hosts (Fedora/RHEL): users may need to set
  //   "runArgs": ["--security-opt", "label=disable"]
  // or configure :Z mounts in their local devcontainer settings.
  // Docker users: these settings are harmless and ignored.

  "containerEnv": {
    "DOTNET_CLI_TELEMETRY_OPTOUT": "1"
  }
}
